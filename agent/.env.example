# Copy to .env.local (cp .env.example .env.local && chmod 600 .env.local) and fill in privately. Never share this file.

# LiveKit: on the free trial, use your own free LiveKit Cloud project (Settings > API keys).
# On Chert's Shared plan, leave all three empty: calls then run in Chert's LiveKit.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Chert's brain (ChatGPT), speech to text, and the backup voice.
OPENAI_API_KEY=
BRAIN_MODEL=gpt-4.1-mini
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts

# Chert's voice (ElevenLabs). Voice IDs: in ElevenLabs open Voices, pick one, Copy voice ID.
ELEVENLABS_API_KEY=
CHERT_VOICE_ID=
MABEL_VOICE_ID=
ELEVEN_MODEL=eleven_flash_v2_5

# A name no other team uses on the shared line. Must match what the agent registers.
AGENT_NAME=chertbusters

# Chert's bridge already mixes everyone into one audio track; the agent detects that.
# Set to 1 only if you are running against a non-Chert room that still mixes audio.
MIXED_AUDIO=0

# Player count when the caller tiles cannot be detected. 0 = use the tile count.
# Set 2 if two people call from one phone, or if the FaceTime window layout is unusual.
PLAYERS=0

# Lobby hand-raise calibration. 0 = skip it and go left-to-right.
CALIBRATE=1

# Caller-tile detection. Leave TILE_COUNT=0 to detect automatically.
# TILE_COUNT=2 forces two equal columns when detection finds nothing.
TILE_COUNT=0
# Or pin the exact crop boxes in normalized coordinates: "x,y,w,h;x,y,w,h".
TILE_RECTS=
# 1 = save caller-view-1.jpg (with boxes drawn) and caller-view-1.json next to this file.
TILE_DEBUG=0

# 1 = show the game window on your Mac while the agent runs (handy for testing).
SHOW_GAME=0
# 1 = force Chromium software GL if MediaPipe or Three.js cannot get a GPU context.
GAME_SOFTWARE_GL=0
# Optional Chromium binary if Playwright's bundled one is not the right build.
CHROME_PATH=

# Camera challenge tuning.
FREEZE_MOTION=9
VOICE_DELAY_MS=0
VIDEO_KBPS=3500
